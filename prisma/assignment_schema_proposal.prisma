// Assignment & Integrity Rules - Schema Proposal
// Add to backend/prisma/schema.prisma

model Assignment {
  id                String   @id @default(uuid())
  workspaceId       String
  title             String
  description       String?
  instructorId      String
  dueAt             DateTime?
  status            String   @default("draft") // draft, published, closed
  integrityRules    Json     // { aiAllowed: 'none'|'outline'|'research'|'full', collaborationAllowed: boolean, maxCopyPasteChars: Int, citationRequired: boolean }
  attestationRequired Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instructor  User      @relation("AssignmentInstructor", fields: [instructorId], references: [id])
  members     AssignmentMember[]
  projects    Project[] @relation("AssignmentProjects")
  attestations AssignmentAttestation[]
  reports     AuthorshipConfidenceReport[] @relation("AssignmentReports")

  @@index([workspaceId])
  @@index([instructorId])
  @@map("assignments")
}

model AssignmentMember {
  id           String   @id @default(uuid())
  assignmentId String
  userId       String
  role         String   @default("student") // student, reviewer
  joinedAt     DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@map("assignment_members")
}

model AssignmentAttestation {
  id           String   @id @default(uuid())
  assignmentId String
  projectId    String?
  userId       String
  signedAt     DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  rulesSnapshot Json

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
  @@map("assignment_attestations")
}

